# Copy to .env and fill in. Never commit the real .env.

# Must match GOOGLE_CLIENT_ID on the server. This value ships in the browser
# bundle and is not a secret, but it is account-specific.
VITE_GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com

# Base URL of the API. Defaults to http://localhost:5001 when unset.
VITE_API_URL=http://localhost:5001
